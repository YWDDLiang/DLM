    "effective_batch_sequences": 64,
    "distributed_batch": {
      "world_size": 2,
      "per_device_microbatch": 8,
      "gradient_accumulation": 4,
      "formula": "world_size * per_device_microbatch * gradient_accumulation = effective_batch_sequences"
    },
    "optimization": {
      "learning_rate": 0.0001,
      "warmup_fraction": 0.03,
      "scheduler": "constant_with_warmup",
      "rationale": "The cancelled 20k-step run showed stable gradients at 1e-4; under a three-epoch horizon cosine would confound later checkpoints by decaying almost to zero."
    },
    "save_strategy": "epoch",
    "save_total_limit": 3,
    "load_best_model_at_end": false,
    "final_adapter_source": "epoch_3",
