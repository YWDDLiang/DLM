        "thresholds_ev_per_atom": {
          "strict": 0.0,
          "meta_like": 0.1
        },
        "selection_metrics": {
          "primary": "attempt_strict_full_sun_lower_bound",
          "secondary": "attempt_meta_full_sun_lower_bound",
          "legacy_reconstructed_denominator_rates": "report_only_for_exact_R5-C_A100_comparability",
          "coverage_adjusted_estimates": "report_only_never_checkpoint_selection"
        },
        "attempt_denominator": 256,
        "paired_bootstrap_draws": 10000,
        "equivalence_rule": "paired_95pct_ci_for_difference_from_point_best_contains_zero",
        "denominator_rule": "A100 novelty_uniqueness_CHGNet_and_MP_hull_numerators_are_unchanged; generation_failures_reconstruction_failures_relaxation_failures_and_missing_hull_remain_false_on_all_256_attempts"
      },
      "crysllmgen_direct_metrics": {
        "source": "unchanged_upstream_compute_metrics.py",
        "higher_is_better": [
          "comp_valid",
          "struct_valid",
          "valid",
          "cov_recall",
          "cov_precision"
        ],
        "lower_is_better": [
          "wdist_density",
          "wdist_num_elems"
        ],
        "absolute_collapse_guards": {
          "comp_valid_min_percent": 70.0,
          "struct_valid_min_percent": 95.0,
          "valid_min_percent": 70.0,
          "cov_recall_min_percent": 80.0,
          "cov_precision_min_percent": 90.0,
          "wdist_density_max": 1.5,
          "wdist_num_elems_max": 0.5
