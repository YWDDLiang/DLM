        "noninferiority_from_metric_best": {
          "comp_valid_drop_max_pp": 3.0,
          "struct_valid_drop_max_pp": 1.0,
          "valid_drop_max_pp": 3.0,
          "cov_recall_drop_max_pp": 3.0,
          "cov_precision_drop_max_pp": 2.0,
          "wdist_density_increase_max": 0.15,
          "wdist_num_elems_increase_max": 0.1
        }
      },
      "procedure": [
        "reject_any_checkpoint_failing_attempt_accounting_or_absolute_collapse_guards",
        "retain_only_checkpoints_noninferior_to_the_per_metric_best_on_every_direct_crysllmgen_metric",
        "find_the_highest_attempt_strict_full_sun_lower_bound_checkpoint",
        "if_its_paired_95pct_strict_sun_difference_ci_is_strictly_positive_against_every_other_eligible_checkpoint_select_it",
        "otherwise_form_the_strict_sun_equivalent_set_and_repeat_the_paired_rule_with_attempt_meta_full_sun_lower_bound",
        "if_meta_like_is_also_equivalent_select_lexicographically_by_valid_cov_hmean_comp_valid_struct_valid_lower_density_wdist_lower_num_elem_wdist_novel_unique_lower_validation_nll_then_lower_epoch",
        "always_report_exact_legacy_reconstructed_denominator_strict_and_meta_rates_but_never_use_coverage_adjusted_estimates_for_selection"
      ],
      "no_eligible_checkpoint_action": "selection_gate_fails_and_training_route_stops"
    }
  },
