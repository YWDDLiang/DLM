+def _iter_fixed_stoich_neutral_oxidations(
+    oxidation_choices: Sequence[Sequence[int]],
+    counts: Sequence[int],
+) -> Iterable[Tuple[int, ...]]:
+    """Yield the same fixed-stoichiometry witnesses as SMACT, with exact pruning."""
+
+    fixed_counts = tuple(int(value) for value in counts)
+    if not fixed_counts or any(not choices for choices in oxidation_choices):
+        return
+    if reduce(math.gcd, fixed_counts) != 1:
+        return
+
+    size = len(fixed_counts)
+    suffix_min = [0] * (size + 1)
+    suffix_max = [0] * (size + 1)
+    for index in range(size - 1, -1, -1):
+        contributions = [
+            fixed_counts[index] * int(oxidation)
+            for oxidation in oxidation_choices[index]
+        ]
+        suffix_min[index] = suffix_min[index + 1] + min(contributions)
+        suffix_max[index] = suffix_max[index + 1] + max(contributions)
+
+    chosen: List[int] = []
+
+    def visit(index: int, charge: int) -> Iterable[Tuple[int, ...]]:
+        if index == size:
+            if charge == 0:
+                yield tuple(chosen)
+            return
+        for oxidation in oxidation_choices[index]:
+            oxidation = int(oxidation)
+            next_charge = charge + fixed_counts[index] * oxidation
+            if not (
+                next_charge + suffix_min[index + 1]
+                <= 0
+                <= next_charge + suffix_max[index + 1]
+            ):
+                continue
+            chosen.append(oxidation)
+            yield from visit(index + 1, next_charge)
+            chosen.pop()
+
+    yield from visit(0, 0)
+
+
